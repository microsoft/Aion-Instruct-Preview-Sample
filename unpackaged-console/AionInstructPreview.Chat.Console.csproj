<!--
  AionInstructPreview.Chat.Console: unpackaged console counterpart to the WinUI sample.

  The app streams the model's reply to stdout and takes the framework package
  dependency at runtime through FrameworkDependency.cs.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>AionInstructPreview.Chat.ConsoleApp</RootNamespace>
    <AssemblyName>AionInstructPreview.Chat.Console</AssemblyName>

    <Platforms>ARM64;x64</Platforms>
    <!-- Default unqualified builds to the machine's native architecture.
         PROCESSOR_ARCHITECTURE reports AMD64 on Intel/AMD, so normalise that to
         the MSBuild platform name x64. -->
    <AionNativeArch>$([MSBuild]::ValueOrDefault('$(PROCESSOR_ARCHITEW6432)', '$(PROCESSOR_ARCHITECTURE)'))</AionNativeArch>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">$(AionNativeArch.Replace('AMD64', 'x64'))</Platform>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AionInstructPreview.Text.Framework" Version="[1.0.1]" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.5" />
  </ItemGroup>

</Project>
