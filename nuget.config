<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet feed configuration for AionInstructPreview.Chat.

  Two feeds:
    1. nuget.org for Windows App SDK and CsWinRT.
    2. ./nuget-local/ for the Aion Instruct Preview SDK NuGet package. Download
       AionInstructPreview.Text.Framework.<version>.nupkg from this repo's GitHub
       releases into that folder (Bootstrap.ps1 does this for you); NuGet restore
       picks it up via the pinned PackageReference in the csproj.

  The SDK NuGet ships via this repo's GitHub releases for the developer preview.
  If it is later published to a public feed (e.g. nuget.org), replace
  `aion-instruct-preview-local` with that feed's URL.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="aion-instruct-preview-local" value="./nuget-local" />
  </packageSources>
</configuration>
