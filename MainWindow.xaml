<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AionInstructPreview.Chat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AionInstructPreview.Chat.Models"
    xmlns:controls="using:AionInstructPreview.Chat.Controls">

    <Grid>
        <Grid.Resources>
            <!-- One bubble template, shared by the chat and image-description transcripts.
                 Both are ObservableCollection<Message>, so the only difference between the
                 two views is which collection feeds them. Lives on the root Grid rather than
                 the Window because WinUI 3's Window is not a FrameworkElement and has no
                 Resources collection. -->
            <DataTemplate x:Key="MessageTemplate" x:DataType="models:Message">
                <Border
                    HorizontalAlignment="{x:Bind BubbleAlignment}"
                    MaxWidth="560"
                    Padding="14,10"
                    CornerRadius="14"
                    Margin="0,4"
                    Background="{x:Bind BubbleBrush, Mode=OneWay}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel>
                        <Image
                            Source="{x:Bind Image, Mode=OneWay}"
                            Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                            MaxHeight="220"
                            Stretch="Uniform"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8" />
                        <controls:TypingIndicator
                            Visibility="{x:Bind TypingVisibility, Mode=OneWay}" />
                        <!-- What the user typed, and replies while Markdown rendering is off. -->
                        <TextBlock
                            Text="{x:Bind Text, Mode=OneWay}"
                            Visibility="{x:Bind PlainTextVisibility, Mode=OneWay}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" />
                        <!-- Replies render as Markdown, re-rendered as each chunk arrives.
                             MarkdownView never drops text and never fetches or opens a URL;
                             read the comment at the top of Controls/MarkdownView.cs before
                             changing it. -->
                        <controls:MarkdownView
                            Text="{x:Bind Text, Mode=OneWay}"
                            Visibility="{x:Bind ReplyTextVisibility, Mode=OneWay}"
                            Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind MetricsText, Mode=OneWay}"
                            Visibility="{x:Bind MetricsVisibility, Mode=OneWay}"
                            FontSize="11"
                            Margin="0,4,0,0"
                            Opacity="0.7"
                            Foreground="{x:Bind ForegroundBrush, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind StatusDetail, Mode=OneWay}"
                            Visibility="{x:Bind StatusDetailVisibility, Mode=OneWay}"
                            FontStyle="Italic"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0"
                            Foreground="{x:Bind StatusDetailBrush, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. The rightmost spacer column extends under the
             system caption buttons (min/max/close) and stays empty so they
             don't collide with our content. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="&#x2728;"
                FontSize="18"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
            <TextBlock
                x:Name="AppTitleText"
                Grid.Column="1"
                Text="Aion Instruct Preview"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                FontWeight="SemiBold" />
        </Grid>

        <!-- Main content area. Loading / error overlays stack on top. -->
        <Grid Grid.Row="1">

            <!-- The features are separate APIs with separate state, so they get
                 separate top-level views rather than sharing one crowded input row.
                 Chat owns a LanguageModelContext and accumulates history; image
                 description is stateless per call. -->
            <NavigationView
                x:Name="MainNav"
                Visibility="{x:Bind ViewModel.ChatVisibility, Mode=OneWay}"
                PaneDisplayMode="Top"
                IsSettingsVisible="False"
                IsBackButtonVisible="Collapsed"
                SelectionChanged="OnNavSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Chat" Tag="chat" IsSelected="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Describe image" Tag="image">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEB9F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Text intelligence" Tag="text">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="LoRA validation" Tag="lora">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>

                    <!-- ============================ CHAT ============================ -->
                    <Grid x:Name="ChatView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer
                            Grid.Row="0"
                            x:Name="TranscriptScroller"
                            Padding="20,12,20,8"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                                ItemTemplate="{StaticResource MessageTemplate}" />
                        </ScrollViewer>

                        <StackPanel
                            Grid.Row="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">

                            <!-- Context-full banner. Shown only when Aion Instruct Preview
                                 returned PromptLargerThanContext on the last turn. Disables
                                 the input so the user can't send into a full context. -->
                            <Grid
                                x:Name="ContextFullBanner"
                                Visibility="{x:Bind ViewModel.ContextFullBannerVisibility, Mode=OneWay}"
                                Padding="20,12"
                                Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE946;"
                                    FontSize="16"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="This conversation reached Aion Instruct Preview's context limit. Start a new conversation to keep chatting."
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <Button
                                    Grid.Column="2"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.NewConversationCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.NewConversationButtonEnabled, Mode=OneWay}"
                                    Margin="12,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Glyph="&#xE8BB;"
                                            FontSize="14" />
                                        <TextBlock Text="New conversation" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Settings: the system prompt and the Markdown switch. Collapsed by
                                 default so it doesn't crowd the input. The system prompt takes
                                 effect on the next New conversation, because it is passed to
                                 CreateContext and a context is immutable once created. -->
                            <Expander
                                Margin="20,8,20,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Glyph="&#xE713;"
                                            FontSize="14" />
                                        <TextBlock Text="Settings" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="8">
                                    <TextBox
                                        Header="System prompt"
                                        PlaceholderText="e.g. You are a terse assistant. Answer in one sentence."
                                        Text="{x:Bind ViewModel.SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{x:Bind ViewModel.NewConversationButtonEnabled, Mode=OneWay}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        MinHeight="60"
                                        MaxHeight="120" />
                                    <TextBlock
                                        Text="Applied when you start a new conversation. Leave empty to use the model's default assistant prompt."
                                        FontSize="12"
                                        Opacity="0.7"
                                        TextWrapping="Wrap" />
                                    <InfoBar
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Visibility="{x:Bind ViewModel.SystemPromptPendingVisibility, Mode=OneWay}"
                                        Message="This conversation is still using the previous system prompt. Start a new conversation to apply the change." />
                                    <!-- Switches replies between rendered Markdown and the raw text
                                         the model wrote, to compare the two. -->
                                    <CheckBox
                                        x:Name="RenderMarkdownToggle"
                                        Content="Render replies as Markdown"
                                        IsChecked="True"
                                        Checked="OnRenderMarkdownToggled"
                                        Unchecked="OnRenderMarkdownToggled" />
                                </StackPanel>
                            </Expander>

                            <Grid Padding="20,8,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="PromptBox"
                                    Grid.Column="0"
                                    PlaceholderText="Type a message. Enter to send, Shift+Enter for a new line…"
                                    Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{x:Bind ViewModel.InputEnabled, Mode=OneWay}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="40"
                                    MaxHeight="160"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,0" />

                                <Button
                                    x:Name="SendButton"
                                    Grid.Column="1"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.SendEnabled, Mode=OneWay}"
                                    VerticalAlignment="Bottom"
                                    Height="40"
                                    Width="40"
                                    Padding="0"
                                    ToolTipService.ToolTip="Send (Enter)">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Glyph="&#xE724;"
                                        FontSize="16" />
                                </Button>

                                <Button
                                    x:Name="NewConversationButton"
                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.NewConversationCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.NewConversationButtonEnabled, Mode=OneWay}"
                                    VerticalAlignment="Bottom"
                                    Height="40"
                                    Width="40"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    ToolTipService.ToolTip="Start a new conversation (clear history)">
                                    <FontIcon
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Glyph="&#xE8BB;"
                                        FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ====================== IMAGE DESCRIPTION ====================== -->
                    <Grid x:Name="ImageView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer
                            Grid.Row="0"
                            x:Name="ImageTranscriptScroller"
                            Padding="20,12,20,8"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.ImageMessages, Mode=OneWay}"
                                ItemTemplate="{StaticResource MessageTemplate}" />
                        </ScrollViewer>

                        <StackPanel
                            Grid.Row="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">

                            <TextBlock
                                Margin="20,12,20,0"
                                FontSize="12"
                                Opacity="0.7"
                                TextWrapping="Wrap"
                                Text="Pick an image and Aion Instruct Preview will describe it. The first description loads the vision models and may compile caches for several minutes. Image description is independent of the chat conversation." />

                            <Grid Padding="20,8,20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    x:Name="ImageKindBox"
                                    Grid.Column="0"
                                    Header="Description style"
                                    ItemsSource="{x:Bind ViewModel.ImageKinds}"
                                    SelectedItem="{x:Bind ViewModel.SelectedImageKind, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.DescribeEnabled, Mode=OneWay}"
                                    MinWidth="190"
                                    Margin="0,0,12,0" />

                                <Button
                                    x:Name="AttachImageButton"
                                    Grid.Column="1"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Click="OnAttachImageClick"
                                    IsEnabled="{x:Bind ViewModel.DescribeEnabled, Mode=OneWay}"
                                    Height="32"
                                    VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Glyph="&#xEB9F;"
                                            FontSize="14" />
                                        <TextBlock Text="Choose image…" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer x:Name="TextIntelligenceView" Visibility="Collapsed" Padding="24"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="TextToolsLayout" MaxWidth="960" HorizontalAlignment="Stretch"
                              SizeChanged="OnTextLayoutSizeChanged">
                            <StackPanel Spacing="20">
                                <TextBlock Text="Text intelligence" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="Summarize, rewrite or create a table using the built-in task adapters."
                                           TextWrapping="Wrap" Opacity="0.75" />
                                <StackPanel x:Name="TextSkillsView" Spacing="12">
                                    <StackPanel x:Name="TextTaskOptions" Orientation="Horizontal" Spacing="12">
                                        <ComboBox x:Name="TextOperationBox" Header="Task" SelectedIndex="0"
                                                  SelectionChanged="OnTextTaskChanged" MaxWidth="360" HorizontalAlignment="Left"
                                                  IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}">
                                            <ComboBoxItem Content="Summarize text" Tag="Summarize" />
                                            <ComboBoxItem Content="Summarize conversation" Tag="SummarizeConversation" />
                                            <ComboBoxItem Content="Rewrite" Tag="Rewrite" />
                                            <ComboBoxItem Content="Rewrite with custom instruction" Tag="RewriteCustom" />
                                            <ComboBoxItem Content="Convert text to table" Tag="TextToTable" />
                                        </ComboBox>
                                        <ComboBox x:Name="RewriteToneBox" Header="Tone" Visibility="Collapsed"
                                                  ItemsSource="{x:Bind ViewModel.RewriteTones}" SelectedIndex="0"
                                                  SelectionChanged="OnTextTaskChanged" MinWidth="150"
                                                  IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBox x:Name="CustomRewriteInstruction" Header="Instruction" Visibility="Collapsed"
                                             PlaceholderText="For example: make it shorter while preserving the meaning"
                                             TextChanged="OnSkillInputChanged"
                                             IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                    <TextBox x:Name="TextSkillInput" Header="Text" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="160" MaxHeight="320"
                                             PlaceholderText="Paste the text you want to summarize"
                                             TextChanged="OnSkillInputChanged"
                                             IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                    <Button Content="Try an example" Click="OnInsertTextExampleClick"
                                            IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                    <Expander x:Name="ConversationSettings" Header="Conversation options"
                                              Visibility="Collapsed" HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="12">
                                            <ComboBox x:Name="ConversationInputKind" Header="Conversation kind (advisory)" SelectedIndex="0"
                                                      SelectionChanged="OnTextTaskChanged"
                                                      IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}">
                                                <ComboBoxItem Content="Email" />
                                                <ComboBoxItem Content="General conversation" />
                                            </ComboBox>
                                            <NumberBox x:Name="MaxSummaryPoints" Header="Max key points" Value="6"
                                                       Minimum="1" Maximum="100" ValueChanged="OnSummaryPointsChanged"
                                                       IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                            <TextBox x:Name="SummaryLanguage" Header="Language hint (advisory)" Text=""
                                                     TextChanged="OnSkillInputChanged"
                                                     IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                            <TextBlock Text="Conversation kind and language are advisory in this preview. They do not change the prompt or translate the summary."
                                                       TextWrapping="Wrap" Opacity="0.75" />
                                            <CheckBox x:Name="SummaryCitations" Content="Message citations" IsChecked="True"
                                                      Checked="OnSummaryOptionsChanged" Unchecked="OnSummaryOptionsChanged"
                                                      IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                            <CheckBox x:Name="SummaryAttribution" Content="Participant attribution"
                                                      Checked="OnSummaryOptionsChanged" Unchecked="OnSummaryOptionsChanged"
                                                      IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock x:Name="SkillValidationMessage" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <Button x:Name="RunTextSkillButton" Content="Summarize" Click="OnRunTextIntelligenceClick"
                                            IsEnabled="False" Style="{ThemeResource AccentButtonStyle}" />
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="16"
                                            AutomationProperties.Name="Text skill result">
                                        <StackPanel Spacing="8">
                                            <Grid>
                                                <TextBlock Text="Result" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button x:Name="CopySkillButton" Content="Copy" Tag="skill"
                                                        Click="OnCopyTextResultClick" HorizontalAlignment="Right" IsEnabled="False" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind ViewModel.TextResultProvenance, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.SkillProvenanceVisibility, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.75" />
                                            <TextBlock x:Name="SkillResultStatus" Text="{x:Bind ViewModel.TextIntelligenceStatus, Mode=OneWay}"
                                                       AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SkillResultOutput" Text="{x:Bind ViewModel.TextIntelligenceOutput, Mode=OneWay}"
                                                       Visibility="{x:Bind ViewModel.SkillOutputVisibility, Mode=OneWay}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ScrollViewer x:Name="TableResultScroller" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                                                          VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled"
                                                          Visibility="{x:Bind ViewModel.TableVisibility, Mode=OneWay}"
                                                          AutomationProperties.Name="Table result">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.TableHeader, Mode=OneWay}"
                                                                  AutomationProperties.Name="Column headers">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" Padding="8" Width="180">
                                                                    <TextBlock Text="{Binding}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.TableRows, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding Columns}" AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                    BorderThickness="1" Padding="8" Width="180">
                                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind ViewModel.SkillRunningVisibility, Mode=OneWay}" Spacing="8">
                                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Generating moderated text skill results" />
                                    <TextBlock Text="Working - results appear after moderation." AutomationProperties.LiveSetting="Polite" />
                                    <Button x:Name="CancelTextButton" Content="Cancel" Click="OnCancelTextIntelligenceClick"
                                            IsEnabled="{x:Bind ViewModel.CanCancelTextIntelligence, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="Inference runs on this device and requests are moderated. Custom adapters loaded on LoRA validation do not affect these skills."
                                           TextWrapping="Wrap" Opacity="0.75" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="LoRAView" Visibility="Collapsed" Padding="24" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="LoRALayout" MaxWidth="960" HorizontalAlignment="Stretch" SizeChanged="OnLoRALayoutSizeChanged">
                            <StackPanel Spacing="20">
                                <TextBlock Text="LoRA validation" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="ActiveAdapterText" Text="{x:Bind ViewModel.AdapterStatus, Mode=OneWay}"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.AdapterPath, Mode=OneWay}"
                                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.AdapterScope, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.75" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="LoadAdapterButton" Content="{x:Bind ViewModel.LoadAdapterLabel, Mode=OneWay}"
                                                    Click="OnLoadLoRAClick" IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                            <Button x:Name="UnloadAdapterButton" Content="Unload" Click="OnUnloadLoRAClick"
                                                    Visibility="{x:Bind ViewModel.UnloadAdapterVisibility, Mode=OneWay}"
                                                    IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                            <ProgressRing Width="24" Height="24"
                                                          IsActive="{x:Bind ViewModel.IsLoadingAdapter, Mode=OneWay}"
                                                          Visibility="{x:Bind ViewModel.AdapterLoadingVisibility, Mode=OneWay}"
                                                          AutomationProperties.Name="Loading adapter" />
                                        </StackPanel>
                                        <TextBlock x:Name="AdapterFeedbackText" Text="{x:Bind ViewModel.AdapterFeedback, Mode=OneWay}"
                                                   Visibility="{x:Bind ViewModel.AdapterFeedbackVisibility, Mode=OneWay}"
                                                   AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                                        <InfoBar x:Name="AdapterCompatibilityWarning" IsOpen="{x:Bind ViewModel.HasAdapterWarning, Mode=OneWay}"
                                                 IsClosable="False" Severity="Warning" Title="Adapter loaded with a warning"
                                                 Message="{x:Bind ViewModel.AdapterWarningMessage, Mode=OneWay}"
                                                 AutomationProperties.LiveSetting="Polite">
                                            <Expander Header="Native compatibility details" HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch">
                                                <TextBlock x:Name="AdapterNativeDetails" Text="{x:Bind ViewModel.AdapterLoadDetails, Mode=OneWay}"
                                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </Expander>
                                        </InfoBar>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="LoRACompareView" Spacing="12">
                                    <TextBox x:Name="ComparisonPromptInput" Header="Prompt" AcceptsReturn="True"
                                             PlaceholderText="Use the prompt format from your LoRA training"
                                             TextWrapping="Wrap" MinHeight="140" MaxHeight="320" TextChanged="OnComparisonPromptChanged"
                                             IsEnabled="{x:Bind ViewModel.TextToolsEnabled, Mode=OneWay}" />
                                    <TextBlock Text="Compare runs the base model, then your LoRA, with the same prompt and default sampling. Results may vary between runs."
                                               TextWrapping="Wrap" Opacity="0.75" />
                                    <TextBlock x:Name="CompareValidationMessage" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel x:Name="CompareActions" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CompareButton" Content="Compare" Tag="both" Click="OnRunComparisonClick"
                                                Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" />
                                        <Button x:Name="BaseOnlyButton" Content="Run base only" Tag="base" Click="OnRunComparisonClick" IsEnabled="False" />
                                        <Button x:Name="AdaptedOnlyButton" Content="Run with LoRA only" Tag="adapter" Click="OnRunComparisonClick" IsEnabled="False" />
                                    </StackPanel>
                                    <InfoBar x:Name="ComparisonStaleWarning" IsOpen="{x:Bind ViewModel.ComparisonOutOfDate, Mode=OneWay}" IsClosable="False"
                                             Severity="Warning" Title="Results are out of date"
                                             Message="The prompt changed. Run again to compare the current prompt." />
                                    <TextBlock Text="{x:Bind ViewModel.ComparisonProvenance, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.ComparisonDetailsVisibility, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.75" />
                                    <Expander Header="Prompt used for these results" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Visibility="{x:Bind ViewModel.ComparisonDetailsVisibility, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind ViewModel.ComparisonPrompt, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Expander>
                                    <Grid RowSpacing="12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition x:Name="ComparisonSecondColumn" Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Border x:Name="BaseResultCard" Grid.Column="0" Padding="16" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                AutomationProperties.Name="Base model result">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Base model" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BaseResultStatus" Text="{x:Bind ViewModel.BaseStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock x:Name="BaseResultOutput" Text="{x:Bind ViewModel.BaseOutput, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Button x:Name="CopyBaseButton" Content="Copy base result" Tag="base" Click="OnCopyTextResultClick" IsEnabled="False" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="AdaptedResultCard" Grid.Column="1" Padding="16" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                AutomationProperties.Name="LoRA result">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="With LoRA" FontWeight="SemiBold" />
                                                <TextBlock x:Name="AdaptedResultStatus" Text="{x:Bind ViewModel.AdaptedStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock x:Name="AdaptedResultOutput" Text="{x:Bind ViewModel.AdaptedOutput, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <Button x:Name="CopyAdapterButton" Content="Copy LoRA result" Tag="adapter" Click="OnCopyTextResultClick" IsEnabled="False" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind ViewModel.ComparisonRunningVisibility, Mode=OneWay}" Spacing="8">
                                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Generating moderated results" />
                                    <TextBlock Text="Working - results appear after moderation." AutomationProperties.LiveSetting="Polite" />
                                    <Button x:Name="CancelComparisonButton" Content="Cancel" Click="OnCancelTextIntelligenceClick"
                                            IsEnabled="{x:Bind ViewModel.CanCancelTextIntelligence, Mode=OneWay}" />
                                </StackPanel>
                                <Expander Header="Compatibility and validation notes" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <TextBlock Text="Use a safetensors LoRA trained for the shipped Aion Instruct base model with the prompt format used during training. Phi Silica and arbitrary Hugging Face adapters are not interchangeable. Loading checks structural compatibility, not adapter quality or safety. Inference runs on this device and requests remain moderated."
                                               TextWrapping="Wrap" />
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </NavigationView>

            <Border
                x:Name="LoadingOverlay"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <ProgressRing IsActive="True" Width="64" Height="64" />
                    <TextBlock
                        Text="Loading Aion Instruct Preview model…"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="First launch can take several minutes while the model compiles for your NPU. This is expected — please don't close the window."
                        TextWrapping="Wrap"
                        MaxWidth="400"
                        Opacity="0.7"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ErrorOverlay"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="500"
                    Spacing="12"
                    Padding="24">
                    <TextBlock
                        Text="Aion Instruct Preview failed to load"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Opacity="0.85" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>