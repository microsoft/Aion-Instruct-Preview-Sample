<!--
  AionInstructPreview.Chat — WinUI 3 desktop chat sample for the Aion Instruct Preview language model.

  This is the consumer-side counterpart to the Aion Instruct Preview SDK. It mirrors how a
  third-party developer would integrate Aion Instruct Preview in their own app:

    1. Reference AionInstructPreview.Text.Framework via NuGet — provides the WinRT
       projection (winmd → CsWinRT-generated C# types) at build time.
    2. Declare a runtime PackageDependency on Aion Instruct Preview.LanguageModel in
       Package.appxmanifest — installed separately (Store, sideload MSIX,
       or winget). At launch, Windows resolves the runtimeclasses against
       the dependency package's binaries.

  Build prerequisites:
    - The .NET 9 SDK. All other build-time dependencies (Windows App SDK,
      SDK build tools, CsWinRT, Windows metadata, MSIX loose-layout tooling)
      come from NuGet — no Visual Studio or registry-installed Windows SDK
      is required. `dotnet run` builds, registers the loose layout as a
      development package, and launches it (Developer Mode must be enabled).
    - The Aion Instruct Preview SDK NuGet package (AionInstructPreview.Text.Framework.<version>.nupkg)
      must be available to NuGet restore. For pre-public bootstrap, drop the
      .nupkg from the SDK build pipeline into ./nuget-local/ and the feed
      in nuget.config will pick it up.
    - For run-time, the Aion Instruct Preview SDK MSIX must be installed on the target
      machine (Add-AppxPackage / winget install / Store).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>AionInstructPreview.Chat</RootNamespace>
    <AssemblyName>AionInstructPreview.Chat</AssemblyName>

    <!-- Keep sibling sample projects out of this root project's default item globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);unpackaged-wpf\**;unpackaged-console\**;tools\**</DefaultItemExcludes>
    <Platforms>ARM64;x64</Platforms>
    <!-- Default unqualified builds to the machine's native architecture for MSIX packaging.
         PROCESSOR_ARCHITECTURE reports AMD64 on Intel/AMD, so normalise that to
         the MSBuild platform name x64. -->
    <AionNativeArch>$([MSBuild]::ValueOrDefault('$(PROCESSOR_ARCHITEW6432)', '$(PROCESSOR_ARCHITECTURE)'))</AionNativeArch>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">$(AionNativeArch.Replace('AMD64', 'x64'))</Platform>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>

    <!-- WinUI 3 packaged app with MSIX identity. -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- Declare the MSIX packaging model for Visual Studio and dotnet run tooling. -->
    <WindowsPackageType>MSIX</WindowsPackageType>

    <!-- Use the NuGet-delivered Windows metadata pack for CsWinRT projection generation. -->
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <CsWinRTWindowsMetadata>$([System.IO.Path]::Combine('$(NuGetPackageRoot)', 'microsoft.windows.sdk.net.ref', '$(WindowsSdkPackageVersion)', 'winmd'))</CsWinRTWindowsMetadata>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <WarningLevel>4</WarningLevel>

    <!-- Use the custom Main() in App.xaml.cs so the app can enforce single-instancing before XAML startup. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK reference: provides the WinRT projection and injects the framework PackageDependency. -->
    <PackageReference Include="AionInstructPreview.Text.Framework" Version="[1.0.1]" />

    <!-- WinUI 3 / Windows App SDK. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.5" />
    <!--
      Enables `dotnet run` to register the loose build-output layout as a
      development package (with package identity) and launch it, without
      Visual Studio or a separate Add-AppxPackage step. Build-only, not a
      runtime dependency (PrivateAssets=all keeps it out of the package graph).
    -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\StoreLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Give the AppX packaging pipeline a per-architecture copy of the manifest, rather than
    editing the tracked source file.

    Package.appxmanifest is committed with ProcessorArchitecture="arm64". This target used to
    XmlPoke that file in place, so every x64 build left the working tree dirty and every ARM64
    build flipped it back. In a public repo that is an easy accidental commit, and committing
    the x64 value would silently break ARM64 packaging for everyone who pulled it.

    Instead: copy to the intermediate directory, rewrite the copy, and point @(AppxManifest)
    at it. Same approach the TAEF project uses (AionInstructPreviewRewriteTaefManifestArch),
    which rewrites into $(OutDir) and leaves its source alone.

    The XPath uses local-name() because XmlPoke has no way to bind a namespace prefix for the
    manifest's default namespace.
  -->
  <Target Name="AionInstructChatSyncManifestArch" BeforeTargets="_GenerateCurrentProjectAppxManifest;_GenerateAppxManifest;GenerateAppxManifest" Condition="'$(Platform)' == 'ARM64' Or '$(Platform)' == 'x64'">
    <PropertyGroup>
      <_AionInstructChatManifestArch Condition="'$(Platform)' == 'ARM64'">arm64</_AionInstructChatManifestArch>
      <_AionInstructChatManifestArch Condition="'$(Platform)' == 'x64'">x64</_AionInstructChatManifestArch>
      <_AionInstructChatStagedManifest>$(IntermediateOutputPath)Package.appxmanifest</_AionInstructChatStagedManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="Package.appxmanifest"
          DestinationFiles="$(_AionInstructChatStagedManifest)"
          SkipUnchangedFiles="false" />
    <XmlPoke
      XmlInputPath="$(_AionInstructChatStagedManifest)"
      Query="/*[local-name()='Package']/*[local-name()='Identity']/@ProcessorArchitecture"
      Value="$(_AionInstructChatManifestArch)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_AionInstructChatStagedManifest)" />
    </ItemGroup>
    <Message Importance="high"
             Text="[AionInstructChatSyncManifestArch] $(_AionInstructChatStagedManifest) -&gt; ProcessorArchitecture=$(_AionInstructChatManifestArch)" />
  </Target>

</Project>
