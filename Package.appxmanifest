<?xml version="1.0" encoding="utf-8"?>
<!--
  AionInstructPreview.Chat package manifest.

  This sample declares the framework + Windows App Runtime PackageDependencies
  explicitly below so the manifest is self-describing. The SDK NuGet's targets
  also inject the Aion Instruct Preview framework + WindowsAppRuntime 2
  dependencies at build time, but the injector de-dupes by Name, so these
  explicit entries are left untouched (no duplication). A consumer that omits
  them gets them from the injector instead.

  runFullTrust is required for the WinUI 3 desktop app process.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities" IgnorableNamespaces="uap rescap">
  <Identity Name="AionInstructPreviewChat" Publisher="CN=AionInstructPreview" Version="1.0.0.0" ProcessorArchitecture="arm64" />
  <Properties>
    <DisplayName>Aion Instruct Preview Chat</DisplayName>
    <PublisherDisplayName>Aion Instruct Preview</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
    <!--
      Declared explicitly for clarity. AionInstructPreview.Text.Framework.targets
      injects the same two entries at build time and de-dupes by Name, so keeping
      them here in their final form means the build has nothing to rewrite.

      Both are required:
        - the Aion Instruct Preview framework carries the model, muffinapi and the
          SDK's own WinML + ONNX Runtime;
        - WindowsAppRuntime 2 is the WinUI 3 / Windows App SDK dependency.

      There is deliberately no WindowsAppRuntime 1.8 entry. It used to supply the
      WinML stack the model ran on; the framework now ships its own WinML and ORT,
      and the SDK's targets actively remove a 1.8 dependency if it finds one.
    -->
    <PackageDependency Name="Microsoft.AionInstructPreview.Framework.1.0" MinVersion="1.0.0.3" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.0.1.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements DisplayName="Aion Instruct Preview Chat" Description="Desktop chat sample for the Aion Instruct Preview language model" BackgroundColor="transparent" Square150x150Logo="Assets\StoreLogo.png" Square44x44Logo="Assets\StoreLogo.png">
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>